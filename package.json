{
  "name": "wayshrine",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test desktop/steam-tests.cjs && vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "content": "node scripts/build-content.ts",
    "desktop:package": "npm run build && node scripts/package-desktop.mjs",
    "test:browser": "node --test scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "electron": "45.5.0",
    "playwright-core": "1.65.1",
    "steamworks.js": "0.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "license": "Apache-2.0"
}
